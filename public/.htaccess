<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Pas de règle « Redirect Trailing Slashes » (rapport ANSSI du 17/11/2026, Vul-003
    # « Chaîne de redirection non sécurisée ») : derrière le reverse proxy HTTPS de l'ANPTIC,
    # Apache ne voit que du HTTP et construisait « Location: http://…/accounts », une étape en
    # clair. Laravel sert déjà /chemin/ comme /chemin : la redirection est inutile.

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Aucun en-tête de sécurité posé ici : le reverse proxy ANPTIC pose déjà X-Frame-Options,
# X-Content-Type-Options, Referrer-Policy, Permissions-Policy, COOP, CORP et HSTS sur toutes
# les réponses (sinon en double). Seule la version de PHP est masquée.
<IfModule mod_headers.c>
    Header unset X-Powered-By
</IfModule>

# Rapport ANSSI du 17/11/2026, Vul-001 : erreurs PHP jamais affichées, toujours journalisées.
# Pris en compte si PHP tourne en module Apache ; en PHP-FPM, c'est public/.user.ini. Le
# php.ini du serveur doit dire la même chose (display_startup_errors, expose_php).
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag display_startup_errors Off
    php_flag html_errors Off
    php_flag log_errors On
</IfModule>
